{
  "name": "inrcliq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:prepare": "prisma generate",
    "build": "node scripts/migrate-deploy.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:migrate-deploy": "node scripts/migrate-deploy.mjs",
    "db:generate": "prisma generate",
    "db:migrate-feed": "node scripts/migrate-feed-to-db.mjs",
    "db:link-creators": "node scripts/link-creators-to-users.mjs",
    "db:migrate-profiles": "node scripts/migrate-profiles-to-db.mjs",
    "db:seed-special-requests": "npx tsx scripts/seed-special-requests-mia.ts",
    "db:provision-special-requests-verified": "npx tsx scripts/provision-special-requests-verified.ts",
    "db:migrate-collection": "node scripts/migrate-collection-to-db.mjs",
    "db:seed-good-guy": "node scripts/seed-good-guy-podcast.mjs",
    "db:seed-bns": "node scripts/seed-bathiya-santhush.mjs",
    "db:seed-top-creators": "node scripts/seed-top-creators.mjs",
    "db:seed-chat": "node scripts/seed-chat-inboxes.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5"
  }
}
