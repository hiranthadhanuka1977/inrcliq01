generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ADULT
  MINOR
  GUARDIAN
}

/** Developmental / content zone derived from date of birth (current age). */
enum AgeZone {
  KIDS
  TEENS
  MATURE_TEENS
  ADULT
}

enum DmDeliveryStatus {
  DELIVERED
  PENDING_REVIEW
  NOT_DELIVERED
}

enum DmHoldStatus {
  PENDING
  ALLOWED
  REJECTED
  EXPIRED
}

enum DmRecipientTreatment {
  WITHHELD
  MASKED_PLACEHOLDER
}

enum SafetyAlertStatus {
  AWAITING_DECISION
  AWAITING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  ALLOWED
  REJECTED
  EXPIRED
}

enum DmRestrictionScope {
  MINORS
}

enum SafetyReviewStatus {
  NONE
  PENDING_REVIEW
  CLEARED
  ACTIONED
}

enum SafetyReportStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

/** Lookup row per age zone: label, age bounds, and UI icon badge key. */
model AgeZoneDefinition {
  zone            AgeZone  @id
  label           String
  /// Stable key used by the UI to render this zone's icon badge.
  iconBadgeKey    String   @unique
  description     String?
  minAgeInclusive Int
  /// Exclusive upper bound in years; null means no upper limit (Adult).
  maxAgeExclusive Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users User[]
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum SpecialRequestStatus {
  RECEIVED
  NEW_OFFER
  COUNTER_OFFER
  OFFER_ACCEPTED
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  DECLINED
  CANCELLED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  firstName     String?
  lastName      String?
  handle        String?     @unique
  dateOfBirth   DateTime?
  /// Current age zone from dateOfBirth. Recompute when DOB changes or on birthday refresh.
  ageZone       AgeZone?
  ageZoneDefinition AgeZoneDefinition? @relation(fields: [ageZone], references: [zone])
  country       String?
  region        String?
  accountType   AccountType @default(ADULT)
  signupMethod    String?
  onboardingStep  String?
  passwordHash    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions               Session[]
  accounts               Account[]
  parentApprovalRequests ParentApprovalRequest[] @relation("ChildUser")
  guardianApprovalRequests ParentApprovalRequest[] @relation("GuardianUser")
  guardianChildren       GuardianChildLink[]     @relation("GuardianChildren")
  childGuardians         GuardianChildLink[]     @relation("ChildGuardians")
  guardianDmControlsAsChild GuardianDmContactControl[] @relation("GuardianDmControlsChild")
  guardianDmControlsAsPeer  GuardianDmContactControl[] @relation("GuardianDmControlsPeer")
  guardianContactTrustBands ChildContactTrustBand[] @relation("GuardianContactTrustBands")
  childContactTrustBands    ChildContactTrustBand[] @relation("ChildContactTrustBands")
  chatThreads            ChatThread[]
  subscriptions          CreatorSubscription[]
  follows                CreatorFollow[]
  hiddenFeedPosts        FeedHiddenPost[]
  guardianSafetyAlertsAsGuardian GuardianSafetyAlert[] @relation("GuardianSafetyAlertsGuardian")
  guardianSafetyAlertsAsChild    GuardianSafetyAlert[] @relation("GuardianSafetyAlertsChild")
  dmHoldsAsSender        DmModerationHold[]     @relation("DmHoldSender")
  dmHoldsAsRecipient     DmModerationHold[]     @relation("DmHoldRecipient")
  dmHoldsDecided         DmModerationHold[]     @relation("DmHoldDecidedBy")
  senderSafetyStrikes    SenderSafetyStrike[]   @relation("SenderSafetyStrikes")
  dmRestrictions         UserDmRestriction[]    @relation("UserDmRestrictions")
  safetyReportsFiled     SafetyReport[]         @relation("SafetyReportsFiled")
  safetyReportsAbout     SafetyReport[]         @relation("SafetyReportsAbout")
  specialRequests        SpecialRequest[]
  creatorProfile         CreatorUser?
  authoredFeedPosts      FeedPost[]
  profile                UserProfile?
  specialRequestCatalog  SpecialRequestCatalog?

  @@index([ageZone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model ParentApprovalRequest {
  id                    String         @id @default(cuid())
  childUserId           String
  parentEmail           String
  guardianUserId        String?
  status                ApprovalStatus @default(PENDING)
  tokenHash             String         @unique
  expiresAt             DateTime
  sentAt                DateTime       @default(now())
  resolvedAt            DateTime?
  protectionLevel       String?
  idDocType             String?
  guardianCountry       String?
  guardianRegion        String?
  childLivesWithGuardian Boolean?
  childLocationCountry  String?
  childLocationRegion   String?
  continueTokenHash     String?        @unique
  continueTokenExpiresAt DateTime?
  continueTokenUsedAt   DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  childUser    User  @relation("ChildUser", fields: [childUserId], references: [id], onDelete: Cascade)
  guardianUser User? @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: SetNull)
  guardianChildLink GuardianChildLink?

  @@index([parentEmail])
  @@index([childUserId])
  @@index([guardianUserId])
}

/// Durable guardian ↔ minor link established when parent approval completes.
model GuardianChildLink {
  id                      String   @id @default(cuid())
  guardianUserId          String
  childUserId             String
  parentApprovalRequestId String?  @unique
  protectionLevel         String?
  linkedAt                DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  guardianUser          User                   @relation("GuardianChildren", fields: [guardianUserId], references: [id], onDelete: Cascade)
  childUser             User                   @relation("ChildGuardians", fields: [childUserId], references: [id], onDelete: Cascade)
  parentApprovalRequest ParentApprovalRequest? @relation(fields: [parentApprovalRequestId], references: [id], onDelete: SetNull)

  @@unique([guardianUserId, childUserId])
  @@index([guardianUserId])
  @@index([childUserId])
}

/// Guardian controls for a minor's direct message contact (per child inbox thread).
model GuardianDmContactControl {
  id               String   @id @default(cuid())
  childUserId      String
  childThreadId    String
  peerUserId       String?
  peerSlug         String?
  peerHandle       String?
  dmRestricted     Boolean  @default(false)
  requiresApproval Boolean  @default(false)
  blocked          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  childUser User  @relation("GuardianDmControlsChild", fields: [childUserId], references: [id], onDelete: Cascade)
  peerUser  User? @relation("GuardianDmControlsPeer", fields: [peerUserId], references: [id], onDelete: SetNull)

  @@unique([childUserId, childThreadId])
  @@index([childUserId, peerUserId])
}

/// Guardian-assigned trust band for a contact in a child's Safe Contact Circle.
/// contactKey is the chat thread id for DMs, or `sibling:<userId>` for linked siblings.
model ChildContactTrustBand {
  id             String   @id @default(cuid())
  guardianUserId String
  childUserId    String
  contactKey     String
  contactKind    String
  trustBand      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardianUser User @relation("GuardianContactTrustBands", fields: [guardianUserId], references: [id], onDelete: Cascade)
  childUser    User @relation("ChildContactTrustBands", fields: [childUserId], references: [id], onDelete: Cascade)

  @@unique([childUserId, contactKey])
  @@index([guardianUserId, childUserId])
  @@index([childUserId, trustBand])
}

/// Public profile for an auth `User` (1:1). Rich rows come from profile JSON;
/// remaining users get unverified stubs.
model UserProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  slug                   String?  @unique
  displayName            String
  handle                 String   @unique
  avatarInitials         String
  avatarColor            String
  avatarUrl              String?
  coverUrl               String?
  bio                    String   @default("")
  verified               Boolean  @default(false)
  specialRequests        Boolean  @default(false)
  subscriptionPriceLabel String?
  followersLabel         String?
  followingCount         Int      @default(0)
  subscribersCount       Int      @default(0)
  postsCountLabel        Int?
  popularPostsJson       Json?
  pinnedFeedPostIds      String[] @default([])
  source                 String   @default("stub")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verified])
  @@index([slug])
}

/// Seller-owned Special Requests catalog (offerings fans can book).
/// Verified creators are provisioned a row (often blank/hidden until configured).
model SpecialRequestCatalog {
  id        String   @id @default(cuid())
  userId    String   @unique
  enabled   Boolean  @default(true)
  content   Json
  source    String   @default("seed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Feed / storefront creator record. Bridged to auth `User` via `userId`
/// (one onboarded User identity; CreatorUser remains for content relations for now).
model CreatorUser {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  handle         String   @unique
  slug           String?  @unique
  firstName      String?
  lastName       String?
  avatarInitials String
  avatarColor    String
  avatarUrl      String?
  verified       Boolean  @default(false)
  bio            String?
  coverUrl       String?
  source         String   @default("feed-json")
  userId         String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts           FeedPost[]
  collections     CreatorCollection[]
  chatThreads     ChatThread[]
  subscriptions   CreatorSubscription[]
  follows         CreatorFollow[]
  specialRequests   SpecialRequest[]
  unavailableDates  CreatorUnavailableDate[]

  @@index([name])
}

/// Calendar dates a creator has marked unavailable for new bookings.
model CreatorUnavailableDate {
  id        String   @id @default(cuid())
  creatorId String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  creator CreatorUser @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, date])
}

/// Single source for home feed and profile feed posts (seed JSON merged via `npm run db:merge-feed-json`).
/// Linked to `CreatorUser` (content author) and optionally to auth `User` via `userId`.
model FeedPost {
  id          String   @id
  category    String
  text        String
  tags        String[]
  mediaJson   Json?
  audioJson   Json?
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  following   Boolean  @default(false)
  membersOnly Boolean  @default(false)
  postedAt    DateTime
  postedAgo   String?
  sortOrder   Int      @default(0)
  creatorId   String
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator    CreatorUser @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  authorUser User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([creatorId])
  @@index([userId])
  @@index([postedAt])
  @@index([sortOrder])
}

/// Creator shop/collection storefront, linked to `CreatorUser`.
model CreatorCollection {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String
  enabled   Boolean  @default(true)
  source    String   @default("collection-json")
  creatorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  CreatorUser         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  products CollectionProduct[]

  @@index([creatorId])
}

/// Products inside a creator collection (detail/offer nested JSON preserved).
model CollectionProduct {
  id             String   @id @default(cuid())
  productKey     String
  kind           String
  name           String
  price          String
  compareAtPrice String?
  description    String
  image          String
  imageAlt       String
  rating         Float    @default(0)
  soldLabel      String
  offerJson      Json?
  ctaLabel       String?
  detailJson     Json?
  active         Boolean  @default(true)
  published      Boolean  @default(false)
  sortOrder      Int      @default(0)
  collectionId   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  collection CreatorCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productKey])
  @@index([collectionId])
  @@index([kind])
  @@index([sortOrder])
}

/// 1:1 chat thread between a logged-in `User` and a peer (creator or support).
model ChatThread {
  id              String    @id @default(cuid())
  userId          String
  seedKey         String?
  peerCreatorId   String?
  peerName        String
  peerHandle      String
  peerInitials    String
  peerAvatarColor String
  peerAvatarUrl   String?
  peerSlug        String?
  peerOnline      Boolean   @default(false)
  preview         String?
  lastMessageAt   DateTime?
  unreadCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  peerCreator     CreatorUser?  @relation(fields: [peerCreatorId], references: [id], onDelete: SetNull)
  messages        ChatMessage[]
  specialRequests SpecialRequest[]

  @@unique([userId, peerCreatorId])
  @@unique([userId, seedKey])
  @@index([userId, lastMessageAt])
  @@index([peerCreatorId])
}

model ChatMessage {
  id               String   @id @default(cuid())
  threadId         String
  body             String
  fromMe           Boolean
  /// When true, recipients (fromMe=false) see a masked placeholder instead of `body`.
  contentMasked    Boolean  @default(false)
  specialRequestId String?
  /// Sender copy: PENDING_REVIEW / NOT_DELIVERED while held or after rejection.
  /// Mature Teens placeholder copy: PENDING_REVIEW, then DELIVERED (allowed) or NOT_DELIVERED (rejected).
  deliveryStatus   DmDeliveryStatus @default(DELIVERED)
  moderationHoldId String?
  createdAt        DateTime @default(now())

  thread         ChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  specialRequest SpecialRequest?   @relation(fields: [specialRequestId], references: [id], onDelete: SetNull)
  moderationHold DmModerationHold? @relation(fields: [moderationHoldId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([specialRequestId])
  @@index([moderationHoldId])
}

/// A flagged DM to a monitored minor awaiting guardian decision.
/// `body` is the only place the raw held text lives; it is purged after the retention window.
model DmModerationHold {
  id                 String               @id @default(cuid())
  senderUserId       String
  recipientUserId    String
  senderThreadId     String
  senderMessageId    String               @unique
  /// Recipient's inbox thread. Null until the thread exists (created on placeholder or delivery).
  recipientThreadId  String?
  /// Mature Teens: the placeholder message. Kids/Teens: set on Allow when delivered.
  recipientMessageId String?
  body               String?
  contentType        String               @default("text")
  category           String
  severity           Int
  senderZone         AgeZone
  recipientZone      AgeZone
  recipientTreatment DmRecipientTreatment
  status             DmHoldStatus         @default(PENDING)
  decidedByUserId    String?
  decidedAt          DateTime?
  expiresAt          DateTime
  bodyPurgedAt       DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  sender    User  @relation("DmHoldSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User  @relation("DmHoldRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DmHoldDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  messages ChatMessage[]
  alerts   GuardianSafetyAlert[]
  strikes  SenderSafetyStrike[]

  @@index([recipientUserId, status])
  @@index([senderUserId, createdAt])
  @@index([status, expiresAt])
}

model SenderSafetyStrike {
  id         String    @id @default(cuid())
  userId     String
  holdId     String?   @unique
  category   String
  severity   Int
  createdAt  DateTime  @default(now())
  /// Set when a guardian Allows the held message (not an offence).
  voidedAt   DateTime?
  voidReason String?

  user User              @relation("SenderSafetyStrikes", fields: [userId], references: [id], onDelete: Cascade)
  hold DmModerationHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model UserDmRestriction {
  id           String             @id @default(cuid())
  userId       String
  scope        DmRestrictionScope @default(MINORS)
  /// "repeat_strikes" | "human_review"
  reason       String
  startsAt     DateTime           @default(now())
  /// Null = indefinite (pending human review).
  endsAt       DateTime?
  reviewStatus SafetyReviewStatus @default(NONE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation("UserDmRestrictions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, endsAt])
}

model SafetyReport {
  id                       String             @id @default(cuid())
  /// Null for system reports.
  reporterUserId           String?
  subjectUserId            String
  holdId                   String?
  alertId                  String?
  /// "guardian" | "system"
  source                   String
  reason                   String
  details                  String?
  /// "normal" | "urgent"
  priority                 String             @default("normal")
  mandatoryReportCandidate Boolean            @default(false)
  status                   SafetyReportStatus @default(OPEN)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  reporter User? @relation("SafetyReportsFiled", fields: [reporterUserId], references: [id], onDelete: SetNull)
  subject  User  @relation("SafetyReportsAbout", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([subjectUserId])
  @@index([holdId])
  @@index([reporterUserId, alertId])
}

/// Append-only audit trail for child-safety actions. Never store raw message text here.
model SafetyAuditEvent {
  id            String   @id @default(cuid())
  action        String
  /// Null for system actions.
  actorUserId   String?
  childUserId   String?
  /// The sender / counterpart.
  subjectUserId String?
  holdId        String?
  alertId       String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([childUserId, createdAt])
  @@index([holdId])
  @@index([subjectUserId, createdAt])
}

/// Fan special request / booking linked to both requester (`User`) and creator (`CreatorUser`).
model SpecialRequest {
  id                 String               @id @default(cuid())
  reference          String               @unique
  status             SpecialRequestStatus @default(RECEIVED)
  userId             String
  creatorId          String
  threadId           String?
  requestLabel       String
  category           String?
  occasion           String?
  contentType        String?
  duration           String?
  publishingMethod   String?
  recipientLabel     String?
  recipientUsername  String?
  shoutoutMessage    String?
  specialInstructions String?
  isAppearance       Boolean              @default(false)
  instantBooking     Boolean              @default(false)
  appearanceLocation String?
  appearanceExpectation String?
  appearanceReference String?
  dayRate            Int                  @default(0)
  feedFee            Int                  @default(0)
  totalFee           Int                  @default(0)
  currency           String               @default("USD")
  requestedForAt     DateTime?
  deliverBy          DateTime?
  acceptedAt         DateTime?
  declinedAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  detailsJson        Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator  CreatorUser  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  thread   ChatThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, createdAt])
  @@index([creatorId, status, createdAt])
  @@index([status, createdAt])
  @@index([threadId])
}

/// Per-user subscription to a creator (`User` → `CreatorUser`).
model CreatorSubscription {
  id           String             @id @default(cuid())
  userId       String
  creatorId    String
  status       SubscriptionStatus @default(ACTIVE)
  notifyLevel  String             @default("personalized")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  cancelledAt  DateTime?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator CreatorUser @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([creatorId, status])
  @@index([userId, status])
}

/// Free follow relationship (`User` → `CreatorUser`), distinct from paid subscription.
model CreatorFollow {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator CreatorUser @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId, createdAt])
  @@index([creatorId])
}

/// Per-user feed dismissals (“Remove this post from my feed”).
model FeedHiddenPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

/// Guardian-facing safety alert (e.g. DM text moderation involving a linked child).
/// Never store raw message bodies here — safe summaries only.
model GuardianSafetyAlert {
  id            String   @id @default(cuid())
  guardianUserId String
  childUserId   String
  priority      String   @default("high")
  category      String
  actionTaken   String
  status        SafetyAlertStatus @default(AWAITING_ACKNOWLEDGEMENT)
  source        String   @default("dm_text_moderation")
  chatThreadId  String?
  chatMessageId String
  peerUserId    String?
  holdId        String?
  /// True when the counterpart is an adult; drives the "Adult account" badge.
  counterpartIsAdult Boolean @default(false)
  createdAt     DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt    DateTime?
  resolvedByUserId String?

  guardian User @relation("GuardianSafetyAlertsGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  child    User @relation("GuardianSafetyAlertsChild", fields: [childUserId], references: [id], onDelete: Cascade)
  hold     DmModerationHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)

  @@unique([guardianUserId, chatMessageId])
  @@index([guardianUserId, status, createdAt])
  @@index([childUserId, createdAt])
  @@index([chatMessageId])
  @@index([holdId])
}
