DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/inrcliq?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Microsoft Clarity — injected only on the Vercel production host, never locally.
NEXT_PUBLIC_CLARITY_PROJECT_ID="your-clarity-project-id"

# HTTP Basic Auth (site gate)
# On Vercel this is ON automatically (VERCEL=1). Locally it stays off unless enabled.
# BASIC_AUTH_ENABLED=true
# BASIC_AUTH_USER=demo@inrcliq.com
# BASIC_AUTH_PASSWORD=demo@inrcliq.com
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=demo@inrcliq.com
BASIC_AUTH_PASSWORD=demo@inrcliq.com

# Email (Amazon SES SMTP)
# Use EMAIL_PROVIDER=console to log emails locally without sending.
EMAIL_PROVIDER=smtp
EMAIL_FROM=hello@inrcliq.com
EMAIL_FROM_NAME=InrCliq
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ses-smtp-username
SMTP_PASS=your-ses-smtp-password

# ── Real backend integration ────────────────────────────────────────────────
# Which backend answers the auth + onboarding routes.
#   mock (default) → this repo's own database, fully self-contained
#   live           → the InrCliq API (inrcliq-backend)
# Everything else (feed, seller, settings, guardian) always stays on the mock —
# those have no backend equivalent yet, so DATABASE_URL is required in both modes.
BACKEND_MODE=mock
BACKEND_URL=http://localhost:3030/api/v1

# ── SSO (only needed once the Google/Apple buttons are wired) ────────────────
# The browser talks to Keycloak directly for the consent redirect, so these are
# NEXT_PUBLIC_. No client secret belongs here — the browser client is public and
# uses PKCE. See inrcliq-backend/docs/04-devops/SSO_SETUP.md.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=inrcliq
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=inrcliq-frontend
# Must match a Valid Redirect URI on that Keycloak client, exactly.
NEXT_PUBLIC_SSO_REDIRECT_URI=http://localhost:3002/auth/callback
