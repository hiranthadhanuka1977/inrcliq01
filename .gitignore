# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

# local workspace copies (app lives at repo root for Vercel)
/inrcliq/
/livefeed/
/web/
/.sync-backup/
/data/db-export/
.vercel
.env*

.env.vercel*
.env.local

# seller-uploaded images (keep folder via .gitkeep)
/public/uploads/seller-service-requests/*
!/public/uploads/seller-service-requests/.gitkeep
/public/uploads/feed-posts/*
!/public/uploads/feed-posts/.gitkeep
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
/public/uploads/booking-accept/*
!/public/uploads/booking-accept/.gitkeep
/public/uploads/covers/*
!/public/uploads/covers/.gitkeep

